# ============================================================
# Concert Ticketing System - Variables de Entorno
# ============================================================
# Copia este archivo como .env en la raíz del proyecto.
# Los valores por defecto están listos para ejecución local.
# ============================================================

# Environment
ENVIRONMENT=development

# ------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ------------------------------------------------------------
# Direct API Configuration (Arquitectura Directa)
# ------------------------------------------------------------
DIRECT_API_HOST=0.0.0.0
DIRECT_API_PORT=8000
DIRECT_API_WORKERS=1

# ------------------------------------------------------------
# Indirect Gateway Configuration (Arquitectura Indirecta)
# ------------------------------------------------------------
INDIRECT_GATEWAY_HOST=0.0.0.0
INDIRECT_GATEWAY_PORT=8080
INDIRECT_GATEWAY_WORKERS=1

# ------------------------------------------------------------
# Worker Configuration (Arquitectura Indirecta)
# ------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_PREFETCH_COUNT=10

# ------------------------------------------------------------
# System Configuration
# ------------------------------------------------------------
TOTAL_TICKETS=20000
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Benchmark Configuration
# ------------------------------------------------------------
BENCHMARK_CONCURRENCY=50
BENCHMARK_TIMEOUT=30
ENVEOF
echo "✅ .env created"
cat /home/ubuntu/Practica_SD/.env
✅ .env created
