# Variables comunes del proyecto
LOG_LEVEL=INFO
TOTAL_TICKETS=20000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# API directa
DIRECT_API_HOST=0.0.0.0
DIRECT_API_PORT=8000

# Benchmark runner
BENCHMARK_BASE_URL=http://localhost
BENCHMARK_CONCURRENCY=50
BENCHMARK_TIMEOUT_SECONDS=60
